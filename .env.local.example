# CMS Go API (login only)
NEXT_PUBLIC_CMS_API_URL=http://localhost:8081

# Same secret as indobox-cms ADMIN_JWT_SECRET
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-min-32-chars

# Shared OLTP — same Postgres as CMS admin, booking API, and device (/v1/device) APIs
CMS_DATABASE_URL=postgres://indobox:indobox@127.0.0.1:5432/indobox
